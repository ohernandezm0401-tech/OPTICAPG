# Copia este archivo a .env.local. No subas .env.local al repositorio.
# Los valores de abajo son de desarrollo. Genera secretos nuevos antes de producción.

# Entorno de la app (PLT-10, T05): desarrollo|pruebas|produccion.
# (`demo` se acepta como alias histórico de `desarrollo` solo en local.)
# En `produccion` el arranque aborta si detecta el secreto de ejemplo, el modo
# de demostración, la bandera de datos sintéticos, el adaptador simulado o
# rastros de desarrollo (ver docs/ENTORNOS.md y `lib/entorno.ts`).
APP_ENV="desarrollo"

# Firma de la cookie de sesión (NextAuth / Auth.js).
# Generar: openssl rand -base64 32
AUTH_SECRET="cambia-este-secreto-solo-en-local"
NEXTAUTH_SECRET="cambia-este-secreto-solo-en-local"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Modo de la app: `demo` habilita los datos sintéticos en memoria y las
# cuentas locales generadas con `npm run seed:dev`. Sin esta variable, en
# producción no hay demo (AC-PLT-02-4); en desarrollo se asume demo.
APP_MODE="demo"

# Límite de intentos fallidos por dirección IP (SEG-01). La spec no fija la
# cifra: sin esta variable no hay límite por IP (el de la cuenta sí: 5
# intentos y 15 min). Ejemplo, sin activar: AUTH_LIMITE_INTENTOS_IP=
#AUTH_LIMITE_INTENTOS_IP=

# Relying party de passkeys (SEG-01, T08). No son secretos. Si faltan, fuera
# de producción se acepta solo localhost o 127.0.0.1. En producción sin estas
# variables el alta de llaves de acceso no se abre.
#WEBAUTHN_RP_ID="localhost"
#WEBAUTHN_ORIGIN="http://localhost:3000"

# Origen público de la verificación del hash de la prescripción (OPT-05, T24).
# Sin esta variable el PDF imprime solo la ruta /verificar/prescripcion/<hash>.
# No hay dominio por defecto: escriba el origen real (http o https, sin ruta).
#PRESCRIPCION_VERIFICACION_BASE_URL=

# Cuentas locales de demostración (PLT-10). Las genera `npm run seed:dev`
# (contraseñas aleatorias por máquina); no versionar este archivo.
#CUENTAS_DEV_JSON='{"admin@visiontotal.com":"..."}'

# Bandera de datos sintéticos (PLT-10). Solo desarrollo/pruebas; en
# `produccion` el arranque aborta si está en `true`.
DATOS_SINTETICOS="true"

# Adaptador de facturación (spec §11.1): `simulado` solo en
# desarrollo/pruebas/demo. En `produccion` el arranque aborta si sigue activo.
FACTURACION_ADAPTADOR="simulado"

# PostgreSQL de la app (PLT-02, T03). Solo datos sintéticos en
# desarrollo/pruebas; nunca datos reales de pacientes.
# Local con compose: docker compose -f ../docker-compose.test.yml up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/optisaas_pruebas"

# PostgreSQL de pruebas (T02, PLT-09/PLT-10). Solo datos sintéticos.
# Local con compose: docker compose -f ../docker-compose.test.yml up -d
#DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/optisaas_pruebas"
# En CI la define el servicio postgres del workflow (puerto 5432).
DATABASE_URL_TEST=""

# TODO(Q-06): hosting y residencia por defecto — PostgreSQL estándar + Drizzle
# (sin SDK propietario), destino en Colombia o país adecuado. La decisión de
# Orlando (proveedor y país) se documenta en `docs/DATOS.md` antes de datos
# reales.

# Clave maestra (KEK) del cifrado envelope (SEG-12). 32 bytes en base64.
# Nunca escriba el valor en este archivo ni lo suba al repositorio.
# Generar: openssl rand -base64 32
# Alternativa: ruta a un archivo fuera del repo (JSON o base64).
# En producción el arranque aborta si faltan ambas.
# APP_MASTER_KEY=
# APP_MASTER_KEY_FILE=/ruta/fuera/del/repo/kek.json
# APP_MASTER_KEY_ID=1
# Claves ya rotadas, mientras se reenvuelven las DEK: id:base64,id:base64
# APP_MASTER_KEYS_ANTERIORES=
